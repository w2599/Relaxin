    "CPU family %@ does not have a supported runtime profile." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يتوفر ملف تعريف وقت تشغيل مدعوم لعائلة وحدة المعالجة المركزية %1$@."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für die CPU-Familie %1$@ ist kein unterstütztes Laufzeitprofil verfügbar."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CPU family %1$@ does not have a supported runtime profile."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La familia de CPU %1$@ no dispone de un perfil de ejecución compatible."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La famille de processeurs %1$@ ne dispose d’aucun profil d’exécution pris en charge."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CPUファミリ%1$@に対応するランタイムプロファイルがありません。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для семейства процессоров %1$@ нет поддерживаемого профиля среды выполнения."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dòng CPU %1$@ không có cấu hình runtime được hỗ trợ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CPU 系列 %1$@ 没有受支持的运行时配置文件。"
          }
        }
      }
    },
