        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une authentification est requise pour modifier le mot de passe de l’utilisateur « mobile »."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「mobile」ユーザーのパスワードを変更するには認証が必要です。"
